# ─────────────────────────────────────────────────────────────
# Пример переменных окружения.
# Скопируйте в .env.local и подставьте свои значения:
#   cp .env.example .env.local
# Файл .env.local не коммитится (см. .gitignore).
# ─────────────────────────────────────────────────────────────

# Базовый URL доменного бэкенда для общих API:
# устройства, каналы, логи, аутентификация, lock/unlock.
BACKEND_URL=http://localhost:8080

# Базовый URL бэкенда для API редактора:
# сцены, компоненты, проекты, теги, палитра, набор автоматизации.
# Должен указывать на gateway: PUT набора автоматизации и восстановление версий требуют
# заголовка X-Username, который ставит только gateway (напрямую в editor — ответ 500).
BACKEND_URL_EDITOR=http://localhost:8080

# REST рантайма (создание сессий монитора) — идёт через gateway.
# Не задан — используется BACKEND_URL.
# BACKEND_URL_RUNTIME=http://localhost:8080

# REST сервиса automation (статусы фоновых задач) — через gateway.
# Не задан — используется BACKEND_URL.
# BACKEND_URL_AUTOMATION=http://localhost:8080

# WebSocket монитора — ТОЛЬКО через gateway (с 17.09.2026 он проксирует и WS).
# Экземпляров runtime может быть несколько, и нужный выбирается по имени экземпляра
# в пути (/ws/runtime/<instanceId>/<sessionId>), который приходит в ответе на создание
# сессии. Прямой адрес сервиса (:8085) выбирать экземпляр не умеет: сессия чужого
# экземпляра закрывается с кодом 1003 «Session belongs to instance …».
NEXT_PUBLIC_RUNTIME_WS_URL=ws://localhost:8080
