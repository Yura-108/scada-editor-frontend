# ─────────────────────────────────────────────────────────────
# Пример переменных окружения.
# Скопируйте в .env.local и подставьте свои значения:
#   cp .env.example .env.local
# Файл .env.local не коммитится (см. .gitignore).
# ─────────────────────────────────────────────────────────────

# Базовый URL доменного бэкенда для общих API:
# устройства, каналы, логи, аутентификация, lock/unlock.
BACKEND_URL=http://localhost:8080

# Базовый URL бэкенда для API редактора:
# сцены, компоненты, проекты, теги, палитра.
BACKEND_URL_EDITOR=http://localhost:8080
