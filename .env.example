# ─────────────────────────────────────────────────────────────
# Пример переменных окружения.
# Скопируйте в .env.local и подставьте свои значения:
#   cp .env.example .env.local
# Файл .env.local не коммитится (см. .gitignore).
# ─────────────────────────────────────────────────────────────

# Базовый URL доменного бэкенда для общих API:
# устройства, каналы, логи, аутентификация, lock/unlock.
BACKEND_URL=http://localhost:8080

# Базовый URL бэкенда для API редактора:
# сцены, компоненты, проекты, теги, палитра.
BACKEND_URL_EDITOR=http://localhost:8080

# REST рантайма (создание сессий монитора) — идёт через gateway.
# Не задан — используется BACKEND_URL.
# BACKEND_URL_RUNTIME=http://localhost:8080

# WebSocket рантайм-сервиса (режим монитора). ВАЖНО: это ПРЯМОЙ адрес
# сервиса :8085 — gateway проксирует только /api/**, не WS-upgrade.
NEXT_PUBLIC_RUNTIME_WS_URL=ws://localhost:8085

# Конверт сохранения сцены/шаблона (контракт версий документов, §1 от 17.08.2026).
# Клиент всегда шлёт PUT {components, scene_id, based_on_version, save_kind}; эта
# переменная решает, что уходит бэкенду:
#   выключено — POST с голым массивом компонентов (старый бэкенд), DELETE компонентов
#               проксируется как раньше;
#   включено  — PUT с конвертом целиком. Тело PUT читается бэкендом как «состав сцены
#               целиком»: компонент, которого в нём нет, удаляется, поэтому отдельный
#               DELETE больше не нужен и роут отвечает no-op.
# Включать ТОЛЬКО когда бэкенд перешёл на новый формат — переключение ломающее в обе
# стороны, но обратимое рестартом. Не задана = выключено (старое поведение).
# EDITOR_SAVE_ENVELOPE=1
