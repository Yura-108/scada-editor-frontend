{
  "name": "scada-editor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-sandbox-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-sandbox-worker.mjs --production",
    "build": "next build",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "test": "vitest run",
    "check:store-cycles": "node scripts/check-store-cycles.mjs",
    "check:ui-colors": "node scripts/check-ui-colors.mjs",
    "check:pr": "npm run lint -- --max-warnings=0 && tsc --noEmit && npm test && npm run check:store-cycles && npm run check:ui-colors && npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-query": "^5.90.11",
    "@tanstack/react-virtual": "^3.14.26",
    "@uiw/react-codemirror": "^4.25.10",
    "acorn": "^8.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dnd-kit": "^0.0.2",
    "framer-motion": "^12.34.4",
    "install": "^0.13.0",
    "konva": "^10.3.0",
    "lodash": "^4.17.23",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^0.555.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "rc-tree": "^5.13.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.66.1",
    "react-konva": "^19.2.4",
    "react-konva-utils": "^2.0.0",
    "react-rnd": "^10.5.2",
    "sockjs-client": "^1.6.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zundo": "^2.3.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/postcss": "^4",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.19.3",
    "@types/rc-tree": "^1.11.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sockjs-client": "^1.5.4",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "baseline-browser-mapping": "^2.9.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "unrs-resolver@1.11.1": true
  }
}
